MONGO_URI=mongodb://localhost:27017
MONGO_DB=tsundere_chat

# Required for chat responses. If missing/invalid, backend returns an error and does NOT fallback.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

# CORS Origins (comma-separated). Add all frontend URLs that need access.
# For production: Add your Vercel/Netlify/etc frontend URL
# Note: All *.vercel.app URLs are automatically allowed via regex pattern
# Example: http://localhost:5173,https://mebmochi.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,https://mebmochi.vercel.app

